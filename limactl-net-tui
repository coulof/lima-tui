#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.10"
# dependencies = ["textual>=0.60", "pyyaml>=6"]
# ///
# <limactl-desc>Draw which Lima VM is on which network (vSwitch), NIC and IP</limactl-desc>
"""
limactl-net-tui — a Lima CLI plugin (a Textual TUI) that draws which Lima VM is
wired to which network (vSwitch), on which NIC, with which IP.

Installed as `limactl-net-tui` on PATH, it runs as `limactl net-tui`.

Each Lima network is one vSwitch panel. Networks come from
`limactl network list` (for names) zipped with `--json` (for details) — a
workaround for the JSON output dropping the name — so even unused networks
show. Live IPs come from inside each guest via
`limactl shell <vm> -- ip -d -j addr show`, correlated to configured networks
by MAC, then interface name, then IP subnet.

CNI noise (cni0, flannel.1, cali*/cilium_*, veth*, kube-ipvs0, ovn0, docker0 …)
is filtered out: those are virtual devices with an `info_kind`; a real VM NIC is
virtio with none. The built-in usermode network is shown separately as a
per-VM NAT, not a shared bus.

    limactl net-tui            # as a plugin (after install; see README)
    ./limactl-net-tui --demo   # direct; the uv shebang installs deps
    uv run limactl-net-tui --demo  # canned data, no Lima needed
    limactl net-tui --print        # dump to stdout, no TUI
    limactl net-tui --dump         # diagnostic: config network[] vs guest NICs

Keys:  r refresh   t toggle vSwitch / VM view   q quit
"""
from __future__ import annotations

import argparse
import ipaddress
import json
import os
import subprocess
from dataclasses import dataclass, field

USER_V2 = "usermode NAT (default, per-VM)"

# ----------------------------------------------------------------------------
# Data model
# ----------------------------------------------------------------------------

@dataclass
class Nic:
    vm: str
    status: str
    ifname: str
    mac: str
    ips: list[str] = field(default_factory=list)


@dataclass
class VSwitch:
    name: str
    kind: str           # shared | bridged | host | socket | user-v2 | vznat | unknown
    shared: bool        # true L2 segment vs per-VM NAT
    subnet: str | None = None
    gateway: str | None = None
    iface: str | None = None
    nics: list[Nic] = field(default_factory=list)


# ----------------------------------------------------------------------------
# Pure parsers (no subprocess — unit-testable)
# ----------------------------------------------------------------------------

def parse_instances(out: str) -> list[dict]:
    """`limactl list --json` is historically JSONL; newer builds emit an array."""
    out = out.strip()
    if not out:
        return []
    try:
        data = json.loads(out)
        return data if isinstance(data, list) else [data]
    except json.JSONDecodeError:
        return [json.loads(line) for line in out.splitlines() if line.strip()]


def parse_guest_ifaces(out: str, keep_virtual: bool = False) -> list[dict]:
    """From `ip -d -j addr show`, return [{mac, ifname, ips}] for REAL NICs only,
    in kernel order.

    A real VM NIC is link_type=ether, not loopback, and has no `info_kind`
    (virtio). CNI/virtual devices (veth, bridge, vxlan, dummy, …) carry an
    info_kind and are dropped unless keep_virtual is set.
    """
    result: list[dict] = []
    for e in json.loads(out):
        ifname = e.get("ifname")
        if ifname == "lo":
            continue
        if e.get("link_type") != "ether":
            continue
        info_kind = (e.get("linkinfo") or {}).get("info_kind")
        if info_kind and not keep_virtual:
            continue
        mac = e.get("address")
        if not mac:
            continue
        ips = [a["local"] for a in e.get("addr_info", []) if a.get("family") == "inet"]
        result.append({"mac": mac, "ifname": ifname, "ips": ips})
    return result


def _cidr(gateway: str | None, netmask: str | None) -> str | None:
    if not (gateway and netmask):
        return None
    try:
        return str(ipaddress.ip_network(f"{gateway}/{netmask}", strict=False))
    except ValueError:
        return None


def parse_networks_yaml(text: str) -> dict[str, dict]:
    import yaml
    data = yaml.safe_load(text) or {}
    nets: dict[str, dict] = {}
    for name, cfg in (data.get("networks") or {}).items():
        cfg = cfg or {}
        nets[name] = {
            "mode": cfg.get("mode", "?"),
            "gateway": cfg.get("gateway"),
            "netmask": cfg.get("netmask"),
            "interface": cfg.get("interface"),
            "cidr": _cidr(cfg.get("gateway"), cfg.get("netmask")),
        }
    return nets


def parse_network_table(text: str) -> list[str]:
    """Extract network names (first column) from `limactl network list`."""
    names: list[str] = []
    for line in text.splitlines():
        line = line.rstrip()
        if not line or line.startswith("NAME"):
            continue
        names.append(line.split()[0])
    return names


def merge_network_list(table_text: str, json_text: str) -> dict[str, dict]:
    """Workaround for lima-vm/lima: `network list --json` drops the name.

    The name is the map key in limactl and never lands in the marshalled
    object, so JSON rows are anonymous. The table output still carries NAME.
    Both branches iterate the same sorted slice, so we zip the names from the
    table onto the detail rows from JSON, positionally.
    """
    names = parse_network_table(table_text)
    rows = parse_instances(json_text)  # same JSONL/array tolerance
    defs: dict[str, dict] = {}
    for name, nw in zip(names, rows):
        defs[name] = {
            "mode": nw.get("mode", "?"),
            "gateway": nw.get("gateway"),
            "netmask": nw.get("netmask"),
            "interface": nw.get("interface"),
            "cidr": _cidr(nw.get("gateway"), nw.get("netmask")),
        }
    return defs


def _instance_networks(inst: dict) -> list[dict]:
    """Configured networks for an instance.

    NOTE: `limactl list --json` emits this under the **singular** key
    `network` (the Instance struct tags it `json:"network"`), even though the
    on-disk lima.yaml and the LimaYAML struct use the plural `networks`. We
    accept both, plus a nested `config.networks`, for robustness.
    """
    return (inst.get("network")
            or inst.get("networks")
            or (inst.get("config") or {}).get("networks")
            or [])


def _match_subnet_label(ips: list[str], defs: dict) -> str | None:
    """Return the name of the first defined network whose CIDR contains one of
    the given IPs. Best-effort only: ambiguous when two networks share a
    subnet (e.g. shared vs user-v2-egress), so this is a last resort after
    MAC/interface matching."""
    for ip in ips:
        try:
            addr = ipaddress.ip_address(ip)
        except ValueError:
            continue
        for name, d in defs.items():
            cidr = d.get("cidr")
            if not cidr:
                continue
            try:
                if addr in ipaddress.ip_network(cidr):
                    return name
            except ValueError:
                continue
    return None


def _label_for(net: dict, defs: dict) -> tuple[str, str, bool]:
    if net.get("lima"):
        nm = net["lima"]
        mode = (defs.get(nm) or {}).get("mode", "shared")
        return f"lima:{nm}", mode, mode in ("shared", "bridged", "host")
    if net.get("socket"):
        return f"socket:{os.path.basename(net['socket'])}", "socket", True
    if net.get("vzNAT"):
        return "vzNAT (per-VM NAT)", "vznat", False
    return "unknown", "unknown", False


# ----------------------------------------------------------------------------
# Backends (real Lima vs demo)
# ----------------------------------------------------------------------------

def _run(cmd: list[str]) -> str:
    return subprocess.run(cmd, capture_output=True, text=True, check=True).stdout


class RealBackend:
    def __init__(self, lima_home: str | None = None, use_yaml: bool = True):
        self.home = lima_home or os.environ.get("LIMA_HOME") or os.path.expanduser("~/.lima")
        self.use_yaml = use_yaml

    def list_instances(self) -> list[dict]:
        insts = parse_instances(_run(["limactl", "list", "--json"]))
        # Defensive: if an instance surfaced no networks (some limactl versions
        # omit them), read the on-disk lima.yaml via its `dir` field.
        for inst in insts:
            if _instance_networks(inst):
                continue
            d = inst.get("dir")
            if not d:
                continue
            try:
                import yaml
                with open(os.path.join(d, "lima.yaml")) as f:
                    y = yaml.safe_load(f) or {}
                if y.get("networks"):
                    inst["networks"] = y["networks"]
            except (OSError, Exception):
                pass
        return insts

    def guest_addr_json(self, name: str) -> str:
        return _run(["limactl", "shell", name, "--", "ip", "-d", "-j", "addr", "show"])

    def network_defs(self) -> dict[str, dict]:
        # Prefer limactl (honours its own LIMA_HOME resolution). Because
        # `network list --json` omits the name, zip the JSON details against
        # the table output, which still has NAME. See lima-vm/lima.
        try:
            table = _run(["limactl", "network", "list"])
            js = _run(["limactl", "network", "list", "--json"])
            defs = merge_network_list(table, js)
            if defs:
                return defs
        except Exception:
            pass
        # Fallback: read networks.yaml directly (keys are the names).
        if self.use_yaml:
            try:
                with open(os.path.join(self.home, "_config", "networks.yaml")) as f:
                    return parse_networks_yaml(f.read())
            except OSError:
                pass
        return {}


