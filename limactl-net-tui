from textual import work
from textual.app import App, ComposeResult
from textual.containers import VerticalScroll
from textual.widgets import Footer, Header, Static


class LimaNetApp(App):
    TITLE = "lima-net"
    SUB_TITLE = "VM ⇄ vSwitch topology"
    CSS = """
    VerticalScroll { padding: 1 2; }
    #diagram { width: 100%; }
    """
    BINDINGS = [
        ("r", "refresh", "Refresh"),
        ("t", "toggle", "Switch/VM view"),
        ("q", "quit", "Quit"),
    ]

    def __init__(self, backend, keep_virtual: bool = False) -> None:
        super().__init__()
        self.backend = backend
        self.keep_virtual = keep_virtual
        self.by_vm = False

    def compose(self) -> ComposeResult:
        yield Header()
        with VerticalScroll():
            yield Static(id="diagram")
        yield Footer()

    def on_mount(self) -> None:
        self.load_data()

    def action_refresh(self) -> None:
        self.load_data()

    def action_toggle(self) -> None:
        self.by_vm = not self.by_vm
        self.sub_title = "VM → networks" if self.by_vm else "VM ⇄ vSwitch topology"
        self.load_data()

    @work(thread=True, exclusive=True)
    def load_data(self) -> None:
        panel = self.query_one("#diagram", Static)
        self.call_from_thread(panel.update, Text("Collecting…", style="dim"))
        try:
            switches = collect(self.backend, self.keep_virtual)
            renderable = render_by_vm(switches) if self.by_vm else render_by_switch(switches)
        except FileNotFoundError:
            renderable = Text("`limactl` not found in PATH. (Try --demo.)", style="bold red")
        except subprocess.CalledProcessError as e:
            renderable = Text(f"limactl failed:\n{e.stderr or e}", style="bold red")
        except Exception as e:  # pragma: no cover
            renderable = Text(f"Error: {e}", style="bold red")
        self.call_from_thread(panel.update, renderable)


# ----------------------------------------------------------------------------
# Entry point
# ----------------------------------------------------------------------------

def main() -> None:
    ap = argparse.ArgumentParser(
        prog="limactl net-tui",
        description="Draw which Lima VM is on which network (vSwitch), NIC and IP.",
        epilog="Runs as a Lima CLI plugin when installed as `limactl-net-tui` on PATH.",
    )
    ap.add_argument("--demo", action="store_true", help="use canned data, no Lima needed")
    ap.add_argument("--print", dest="print_only", action="store_true",
                    help="print the diagram to stdout and exit (no TUI)")
    ap.add_argument("--by-vm", action="store_true", help="start in VM-centric view")
    ap.add_argument("--all-ifaces", action="store_true",
                    help="do NOT filter CNI/virtual interfaces (debug)")
    ap.add_argument("--dump", action="store_true",
                    help="diagnostic: print each VM's configured network[] and "
                         "guest NICs, then exit")
    ap.add_argument("--lima-home", default=None, help="override LIMA_HOME")
    args = ap.parse_args()

    backend = DemoBackend() if args.demo else RealBackend(lima_home=args.lima_home)

    if args.dump:
        defs = backend.network_defs()
        print("# defined networks:")
        for nm, d in defs.items():
            print(f"    {nm:<18} {d.get('mode'):<8} {d.get('cidr') or '-'}")
        for inst in backend.list_instances():
            name, status = inst.get("name", "?"), inst.get("status", "?")
            print(f"\n# {name} [{status}]")
            print(f"    config network[]: {json.dumps(_instance_networks(inst))}")
            if status != "Running":
                continue
            try:
                reals = parse_guest_ifaces(backend.guest_addr_json(name), args.all_ifaces)
            except Exception as e:
                print(f"    (guest query failed: {e})")
                continue
            for r in reals:
                print(f"    {r['ifname']:<8} {r['mac']:<18} {', '.join(r['ips']) or '-'}")
        return

    if args.print_only:
        from rich.console import Console
        switches = collect(backend, args.all_ifaces)
        render = render_by_vm if args.by_vm else render_by_switch
        Console().print(render(switches))
        return

    app = LimaNetApp(backend, keep_virtual=args.all_ifaces)
    app.by_vm = args.by_vm
    app.run()


if __name__ == "__main__":
    main()
